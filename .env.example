# ═══════════════════════════════════════════════════════════════════════════════
# MSP_AXS — Variables de Entorno
# Regenerado 2026-09-24 a partir de un grep real de os.getenv()/os.environ en
# backend/, scripts/ y tests/ — no son valores inventados. Si agregas una
# variable de entorno nueva al código, agrégala aquí también.
#
# Sin NINGUNA variable de este archivo definida, el proyecto arranca igual:
# cada dominio AUP cae a su propio SQLite local (axs_core.db, axs_event.db,
# axs_gov.db). Solo necesitas llenar las DATABASE_*_URL para apuntar a Neon.
# ═══════════════════════════════════════════════════════════════════════════════

# ═══════════════════════════════════════════════════════════════════════════════
# AUP_CORE — Identidad y Alcance (usuarios, condominios, visitas, scopes)
# backend/db/core/engine.py — sin esta var, fallback: sqlite:///./axs_core.db
# ═══════════════════════════════════════════════════════════════════════════════
DATABASE_CORE_URL=postgresql://user:password@host.neon.tech/aup_core?sslmode=require

# ═══════════════════════════════════════════════════════════════════════════════
# AUP_EVENT — Verdad histórica, append-only (log inmutable de eventos)
# backend/db/event/engine.py — sin esta var, fallback: sqlite:///./axs_event.db
# ═══════════════════════════════════════════════════════════════════════════════
DATABASE_EVENT_URL=postgresql://user:password@host.neon.tech/aup_event?sslmode=require

# ═══════════════════════════════════════════════════════════════════════════════
# AUP_GOV — Poder explícito (autoridades, políticas, delegaciones)
# backend/db/gov/engine.py — sin esta var, fallback: sqlite:///./axs_gov.db
# ═══════════════════════════════════════════════════════════════════════════════
DATABASE_GOV_URL=postgresql://user:password@host.neon.tech/aup_gov?sslmode=require

# ═══════════════════════════════════════════════════════════════════════════════
# LEGACY — backend/core/config.py (modelo monolítico backend/db/models.py) y
# el endpoint de diagnóstico GET /debug/db. NO controla los tres engines AUP
# de arriba. Sin esta var, fallback: sqlite:///<repo>/axs_dev.db
# ═══════════════════════════════════════════════════════════════════════════════
DATABASE_URL=postgresql://user:password@host.neon.tech/neondb?sslmode=require

# Parámetros del engine legacy (backend/core/config.py) — opcionales, tienen
# default razonable en código.
ENGINE_POOL_SIZE=5
ENGINE_MAX_OVERFLOW=10
ENGINE_POOL_TIMEOUT=30
ECHO_SQL=false

# ═══════════════════════════════════════════════════════════════════════════════
# AUTH (AUP_SESSION) — backend/core/auth/jwt.py
# ═══════════════════════════════════════════════════════════════════════════════
# IMPORTANTE: cambiar en producción. Generar con: openssl rand -hex 32
SECRET_KEY=your-secret-key-here-CHANGE-IN-PRODUCTION
# Default real en código si se omite: 480 (8 horas)
ACCESS_TOKEN_EXPIRE_MINUTES=480

# ═══════════════════════════════════════════════════════════════════════════════
# UPLOADS — backend/core/config.py, backend/services/evidencia_service.py
# ═══════════════════════════════════════════════════════════════════════════════
UPLOAD_DIR=uploads
MAX_UPLOAD_SIZE_MB=15

# Evidencias: guardar en Cloudinary (true) o solo en filesystem local (false).
# NOTA: el router realmente montado en main.py (evidencias_router.py) sube
# a filesystem local sin importar este flag; el router que sí usa Cloudinary
# (evidencias_router_cloudinary.py) no está montado. Ver CLAUDE.md.
USE_CLOUDINARY=true
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
CLOUDINARY_UPLOAD_PRESET=axs_evidencias

# ═══════════════════════════════════════════════════════════════════════════════
# APP
# ═══════════════════════════════════════════════════════════════════════════════
ENV=development
# Leído por GET /health (backend/main.py). Distinto de ENV, arriba.
ENVIRONMENT=development
APP_NAME=MSP_AXS
LOG_LEVEL=info

# ═══════════════════════════════════════════════════════════════════════════════
# TESTS — normalmente los define tests/conftest.py automáticamente; no hace
# falta ponerlos aquí salvo que quieras reproducir el entorno de CI a mano.
# TESTING=1
# JWT_ALGORITHM=HS256  (nota: no está realmente leído por jwt.py, que usa
#   HS256 fijo — queda documentado porque conftest.py sí lo define)
# ═══════════════════════════════════════════════════════════════════════════════
