# AX-S MSP Backend Environment
# ==================================

# Base de datos
DATABASE_URL=postgresql://user:password@host:port/database

# Modo de entorno
ENV=development

# Carpeta destino para evidencias y uploads
UPLOAD_DIR=uploads

# Tamaño máximo permitido para evidencias (en MB)
MAX_UPLOAD_SIZE_MB=15

# Config general
APP_NAME=AXS-MSP
LOG_LEVEL=info

# ═══════════════════════════════════════════════════════════
# JWT Authentication (AUP_SESSION)
# ═══════════════════════════════════════════════════════════
# IMPORTANTE: Cambiar SECRET_KEY en producción
# Generar con: openssl rand -hex 32
SECRET_KEY=your-secret-key-here-CHANGE-IN-PRODUCTION
ACCESS_TOKEN_EXPIRE_MINUTES=60
